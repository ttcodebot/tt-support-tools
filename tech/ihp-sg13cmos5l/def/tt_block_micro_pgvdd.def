VERSION 5.8 ;
DIVIDERCHAR "/" ;
BUSBITCHARS "[]" ;
DESIGN tt_um_template ;
UNITS DISTANCE MICRONS 1000 ;
DIEAREA ( 0 0 ) ( 86400 68040 ) ;
ROW ROW_0 CoreSite 2880 3780 N DO 168 BY 1 STEP 480 0 ;
ROW ROW_1 CoreSite 2880 7560 FS DO 168 BY 1 STEP 480 0 ;
ROW ROW_2 CoreSite 2880 11340 N DO 168 BY 1 STEP 480 0 ;
ROW ROW_3 CoreSite 2880 15120 FS DO 168 BY 1 STEP 480 0 ;
ROW ROW_4 CoreSite 2880 18900 N DO 168 BY 1 STEP 480 0 ;
ROW ROW_5 CoreSite 2880 22680 FS DO 168 BY 1 STEP 480 0 ;
ROW ROW_6 CoreSite 2880 26460 N DO 168 BY 1 STEP 480 0 ;
ROW ROW_7 CoreSite 2880 30240 FS DO 168 BY 1 STEP 480 0 ;
ROW ROW_8 CoreSite 2880 34020 N DO 168 BY 1 STEP 480 0 ;
ROW ROW_9 CoreSite 2880 37800 FS DO 168 BY 1 STEP 480 0 ;
ROW ROW_10 CoreSite 2880 41580 N DO 168 BY 1 STEP 480 0 ;
ROW ROW_11 CoreSite 2880 45360 FS DO 168 BY 1 STEP 480 0 ;
ROW ROW_12 CoreSite 2880 49140 N DO 168 BY 1 STEP 480 0 ;
ROW ROW_13 CoreSite 2880 52920 FS DO 168 BY 1 STEP 480 0 ;
ROW ROW_14 CoreSite 2880 56700 N DO 168 BY 1 STEP 480 0 ;
ROW ROW_15 CoreSite 2880 60480 FS DO 168 BY 1 STEP 480 0 ;
TRACKS X 480 DO 179 STEP 480 LAYER Metal1 ;
TRACKS Y 420 DO 161 STEP 420 LAYER Metal1 ;
TRACKS X 480 DO 179 STEP 480 LAYER Metal2 ;
TRACKS Y 420 DO 161 STEP 420 LAYER Metal2 ;
TRACKS X 480 DO 179 STEP 480 LAYER Metal3 ;
TRACKS Y 420 DO 161 STEP 420 LAYER Metal3 ;
TRACKS X 480 DO 179 STEP 480 LAYER Metal4 ;
TRACKS Y 420 DO 161 STEP 420 LAYER Metal4 ;
TRACKS X 1640 DO 38 STEP 2280 LAYER TopMetal1 ;
TRACKS Y 1640 DO 30 STEP 2280 LAYER TopMetal1 ;
COMPONENTS 0 ;
END COMPONENTS
PINS 18 ;
    - clk + NET clk + DIRECTION INPUT + USE SIGNAL
      + PORT
        + LAYER Metal3 ( -500 -150 ) ( 500 150 )
        + PLACED ( 85900 2100 ) N ;
    - rst_n + NET rst_n + DIRECTION INPUT + USE SIGNAL
      + PORT
        + LAYER Metal3 ( -500 -150 ) ( 500 150 )
        + PLACED ( 85900 5880 ) N ;
    - ui_in[0] + NET ui_in[0] + DIRECTION INPUT + USE SIGNAL
      + PORT
        + LAYER Metal3 ( -500 -150 ) ( 500 150 )
        + PLACED ( 85900 9660 ) N ;
    - ui_in[1] + NET ui_in[1] + DIRECTION INPUT + USE SIGNAL
      + PORT
        + LAYER Metal3 ( -500 -150 ) ( 500 150 )
        + PLACED ( 85900 13440 ) N ;
    - ui_in[2] + NET ui_in[2] + DIRECTION INPUT + USE SIGNAL
      + PORT
        + LAYER Metal3 ( -500 -150 ) ( 500 150 )
        + PLACED ( 85900 17220 ) N ;
    - ui_in[3] + NET ui_in[3] + DIRECTION INPUT + USE SIGNAL
      + PORT
        + LAYER Metal3 ( -500 -150 ) ( 500 150 )
        + PLACED ( 85900 21000 ) N ;
    - ui_in[4] + NET ui_in[4] + DIRECTION INPUT + USE SIGNAL
      + PORT
        + LAYER Metal3 ( -500 -150 ) ( 500 150 )
        + PLACED ( 85900 24780 ) N ;
    - ui_in[5] + NET ui_in[5] + DIRECTION INPUT + USE SIGNAL
      + PORT
        + LAYER Metal3 ( -500 -150 ) ( 500 150 )
        + PLACED ( 85900 28560 ) N ;
    - ui_in[6] + NET ui_in[6] + DIRECTION INPUT + USE SIGNAL
      + PORT
        + LAYER Metal3 ( -500 -150 ) ( 500 150 )
        + PLACED ( 85900 32340 ) N ;
    - ui_in[7] + NET ui_in[7] + DIRECTION INPUT + USE SIGNAL
      + PORT
        + LAYER Metal3 ( -500 -150 ) ( 500 150 )
        + PLACED ( 85900 36120 ) N ;
    - uo_out[0] + NET uo_out[0] + DIRECTION OUTPUT + USE SIGNAL
      + PORT
        + LAYER Metal3 ( -500 -150 ) ( 500 150 )
        + PLACED ( 85900 39900 ) N ;
    - uo_out[1] + NET uo_out[1] + DIRECTION OUTPUT + USE SIGNAL
      + PORT
        + LAYER Metal3 ( -500 -150 ) ( 500 150 )
        + PLACED ( 85900 43680 ) N ;
    - uo_out[2] + NET uo_out[2] + DIRECTION OUTPUT + USE SIGNAL
      + PORT
        + LAYER Metal3 ( -500 -150 ) ( 500 150 )
        + PLACED ( 85900 47460 ) N ;
    - uo_out[3] + NET uo_out[3] + DIRECTION OUTPUT + USE SIGNAL
      + PORT
        + LAYER Metal3 ( -500 -150 ) ( 500 150 )
        + PLACED ( 85900 51240 ) N ;
    - uo_out[4] + NET uo_out[4] + DIRECTION OUTPUT + USE SIGNAL
      + PORT
        + LAYER Metal3 ( -500 -150 ) ( 500 150 )
        + PLACED ( 85900 55020 ) N ;
    - uo_out[5] + NET uo_out[5] + DIRECTION OUTPUT + USE SIGNAL
      + PORT
        + LAYER Metal3 ( -500 -150 ) ( 500 150 )
        + PLACED ( 85900 58800 ) N ;
    - uo_out[6] + NET uo_out[6] + DIRECTION OUTPUT + USE SIGNAL
      + PORT
        + LAYER Metal3 ( -500 -150 ) ( 500 150 )
        + PLACED ( 85900 62580 ) N ;
    - uo_out[7] + NET uo_out[7] + DIRECTION OUTPUT + USE SIGNAL
      + PORT
        + LAYER Metal3 ( -500 -150 ) ( 500 150 )
        + PLACED ( 85900 66360 ) N ;
END PINS
SPECIALNETS 2 ;
    - VGND + USE GROUND ;
    - VPWR + USE POWER ;
END SPECIALNETS
NETS 18 ;
    - clk ( PIN clk ) + USE SIGNAL ;
    - rst_n ( PIN rst_n ) + USE SIGNAL ;
    - ui_in[0] ( PIN ui_in[0] ) + USE SIGNAL ;
    - ui_in[1] ( PIN ui_in[1] ) + USE SIGNAL ;
    - ui_in[2] ( PIN ui_in[2] ) + USE SIGNAL ;
    - ui_in[3] ( PIN ui_in[3] ) + USE SIGNAL ;
    - ui_in[4] ( PIN ui_in[4] ) + USE SIGNAL ;
    - ui_in[5] ( PIN ui_in[5] ) + USE SIGNAL ;
    - ui_in[6] ( PIN ui_in[6] ) + USE SIGNAL ;
    - ui_in[7] ( PIN ui_in[7] ) + USE SIGNAL ;
    - uo_out[0] ( PIN uo_out[0] ) + USE SIGNAL ;
    - uo_out[1] ( PIN uo_out[1] ) + USE SIGNAL ;
    - uo_out[2] ( PIN uo_out[2] ) + USE SIGNAL ;
    - uo_out[3] ( PIN uo_out[3] ) + USE SIGNAL ;
    - uo_out[4] ( PIN uo_out[4] ) + USE SIGNAL ;
    - uo_out[5] ( PIN uo_out[5] ) + USE SIGNAL ;
    - uo_out[6] ( PIN uo_out[6] ) + USE SIGNAL ;
    - uo_out[7] ( PIN uo_out[7] ) + USE SIGNAL ;
END NETS
END DESIGN
